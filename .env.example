# ─────────────────────────────────────────────────────────────────────────────
# MTB Tinanes — Variables de Entorno Firebase
# Copia este archivo a .env.local y rellena con tus credenciales reales.
# NUNCA subas .env.local a Git (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key

# URL base del backend Render (solo en producción).
# Déjala sin definir en local para usar el proxy de Vite.
# VITE_API_BASE_URL=https://mtb-tinanes-api.onrender.com
